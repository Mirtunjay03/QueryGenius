# Local-only development values. Replace all passwords before using shared infrastructure.
APP_ENV=development
MYSQL_DATABASE=querygenius
MYSQL_USER=querygenius
MYSQL_PASSWORD=replace-before-use
MYSQL_ROOT_PASSWORD=replace-before-use
DATABASE_URL=mysql+pymysql://querygenius:replace-before-use@mysql:3306/querygenius
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173"]
AUTH_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini
VITE_API_PROXY_TARGET=http://api:8000
